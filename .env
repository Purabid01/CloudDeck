APP_NAME=CloudDeck
APP_ENV=development
DEBUG=True
SECRET_KEY=clouddeck-super-secret-jwt-key-change-in-production
DATABASE_URL=postgresql://clouddeck_user:clouddeck_pass@localhost:5432/clouddeck_db
REDIS_URL=redis://localhost:6379/0
OLLAMA_URL=http://host.windows.internal:11434
OLLAMA_MODEL=mistral
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]